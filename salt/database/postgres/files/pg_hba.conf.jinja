# Managed by Salt
# TYPE  DATABASE        USER            ADDRESS                 METHOD

local   all             postgres                                peer
local   all             all                                     md5
host    all             all             127.0.0.1/32            md5
host    all             all             ::1/128                 md5

{#- Pillar names the Vault key that holds each user name (name_key), as
    database.sls does; a literal `name` still works. #}
{%- macro username(u) -%}
{{ salt['pillar.get'](u.name_key) if u.name_key is defined else u.name }}
{%- endmacro %}

{%- for db in salt['pillar.get']('postgres_databases', [], merge=True) %}
host    {{ db.name }}    {{ username(db.users[0]) }}    192.168.0.0/24         md5
host    {{ db.name }}    {{ username(db.users[0]) }}    100.64.0.0/10          md5
{%- endfor %}

{%- for mon_user in salt['pillar.get']('postgres_monitoring_users', [], merge=True) %}
host    all             {{ username(mon_user) }}    192.168.0.0/24         md5
host    all             {{ username(mon_user) }}    100.64.0.0/10          md5
{%- endfor %}