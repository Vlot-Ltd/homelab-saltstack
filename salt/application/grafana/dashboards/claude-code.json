          "query": "label_values(claude_code_session_count_total, billing)",
          "refId": "v"
        },
        "definition": "label_values(claude_code_session_count_total, billing)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
