    {
      "id": 2,
      "type": "stat",
      "title": "Claude Code tokens",
      "description": "Claude Code respects the Machine and Billing filters; LiteLLM is always everything. Input plus output, excluding cache. Each Claude Code session reports its own counter from 0, so this sums each session's highest value in the period. A session running past midnight counts in both days.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum (max_over_time(claude_code_token_usage_tokens_total{host=~\"$host\", billing=~\"$billing\", type=~\"input|output\"}[$__range]))",
          "legendFormat": "Claude Code tokens",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
