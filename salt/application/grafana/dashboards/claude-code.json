        "showPercentChange": false
      },
      "transparent": true
    },
    {
      "id": 3,
      "type": "stat",
      "title": "LiteLLM tokens",
      "description": "Input plus output, all tiers (local and API). LiteLLM on friday, all callers (Home Assistant, scripts, Zed). The Machine and Billing filters don't apply to LiteLLM. Counters from LiteLLM's /metrics/, scraped every 60s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase({__name__=~\"litellm_(input|output)_tokens_metric_total\"}[$__range]))",
          "legendFormat": "LiteLLM tokens",
          "range": false,
