    {
      "id": 2,
      "type": "stat",
      "title": "Estimated cost",
      "description": "Claude Code's own estimate: tokens x API list prices. On billing=pro it's what the usage would have cost on the API, not money spent. On billing=api it tracks real spend. Converted from USD at a fixed 0.744 (2026 average), so it's a guesstimate in pounds. Each Claude Code session reports its own counter from 0, so this sums each session's highest value in the period. A session running past midnight counts in both days.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum (max_over_time(claude_code_cost_usage_USD_total{host=~\"$host\", billing=~\"$billing\"}[$__range])) * $usd_gbp",
          "legendFormat": "Estimated cost",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
