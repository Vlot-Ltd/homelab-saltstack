    {
      "id": 2,
      "type": "gauge",
      "title": "Progress",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(hass_sensor_unit_percent{entity=\"sensor.a1_combo_print_progress\"}) and on() ((hass_binary_sensor_state{entity=\"binary_sensor.a1_combo_online\"} == 1) and on() (hass_sensor_duration_h{entity=\"sensor.a1_combo_remaining_time\"} > 0))",
          "legendFormat": "Progress",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "noValue": "Idle"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": false,
        "showThresholdLabels": false
      },
      "transparent": true,
      "description": "Shown only while a job is running (printer online and time remaining); otherwise \"Idle\"."
    },
