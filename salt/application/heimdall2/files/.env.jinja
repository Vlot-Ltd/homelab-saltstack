# Database Configuration (using shared PostgreSQL server)
DATABASE_PASSWORD={{ salt['pillar.get']('heimdall2_db_password', '') }}
DATABASE_HOST={{ salt['pillar.get']('heimdall2:database_host', 'postgres') }}
DATABASE_NAME={{ salt['pillar.get']('heimdall2:database_name', 'heimdall2') }}
DATABASE_USERNAME={{ salt['pillar.get']('heimdall2_db_user', '') }}
DATABASE_PORT=5432

# NGINX Configuration
NGINX_HOST={{ salt['pillar.get']('heimdall2:nginx_host', 'localhost') }}

# Heimdall2 Configuration
NODE_ENV=production
FORCE_HTTPS=false

# JWT and API Key Secrets
JWT_SECRET={{ salt['pillar.get']('heimdall2_jwt_secret', '') }}
API_KEY_SECRET={{ salt['pillar.get']('heimdall2_api_secret', '') }}

# Optional: LDAP Configuration
{% if salt['pillar.get']('heimdall2:ldap_enabled', False) %}
LDAP_ENABLED=true
LDAP_HOST={{ salt['pillar.get']('heimdall2:ldap_host', '') }}
LDAP_PORT={{ salt['pillar.get']('heimdall2:ldap_port', 389) }}
LDAP_BINDDN={{ salt['pillar.get']('heimdall2:ldap_binddn', '') }}
LDAP_PASSWORD={{ salt['pillar.get']('heimdall2:ldap_password', '') }}
LDAP_SEARCHBASE={{ salt['pillar.get']('heimdall2:ldap_searchbase', '') }}
LDAP_SEARCHFILTER={{ salt['pillar.get']('heimdall2:ldap_searchfilter', '') }}
{% endif %}
